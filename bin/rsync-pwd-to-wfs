#!/usr/bin/env bash

readonly TEAM=$1
readonly MODE=$2
readonly SRC=$3

if [ $TEAM == "vision1" ]; then
  readonly ddir='/mnt/wfs/mmshanghai8wfssh/project_mm-base-vision-tj/nrwu/work'
else
  echo 'unknown team'
  exit 0
fi

if [ "$MODE" != "full" ] && [ "$MODE" != "incr" ]; then
  echo 'unknown cp mode'
fi

if [ $MODE == "full" ]; then
  rsync -av --progress \
    --exclude .git --exclude '*.swp' \
    $SRC $ddir
else
  readonly wdir=`basename $SRC`
  cd $SRC
  readonly fs=`git diff --name-only`
  for f in $fs; do
    to=$ddir/$wdir/$f
    todir=`dirname $to`
    echo "cp $f $to"
    mkdir -p $todir
    cp $f $to
  done
fi
